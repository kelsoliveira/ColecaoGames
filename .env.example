# Copie para .env.local e preencha o que quiser (tudo é opcional).

# Credenciais do IGDB (Twitch) — também podem ser informadas na página "Contas".
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Senha para acessar o site. Deixe vazio para uso apenas no seu computador.
# DEFINA uma senha se for publicar o site na internet: ele guarda os tokens das suas contas.
APP_PASSWORD=

# Pasta do banco de dados SQLite (padrão: ./data)
# DATA_DIR=./data
