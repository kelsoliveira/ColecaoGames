# Copie para .env.local (desenvolvimento) ou cadastre na Vercel em
# Project → Settings → Environment Variables (produção).

# Banco Turso (produção). Sem essas variáveis, o site usa ./data/colecao.db localmente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Senha de acesso ao site. OBRIGATÓRIA na Vercel (o site fica bloqueado sem ela).
APP_PASSWORD=

# Opcional: texto aleatório longo para reforçar a assinatura da sessão de login.
SESSION_SECRET=

# Credenciais do IGDB (Twitch) para capas, gêneros e tempo para zerar.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Guias de platina/100% gerados por IA (console.anthropic.com → API Keys). Cobrado por uso.
ANTHROPIC_API_KEY=

# Opcional: chave da YouTube Data API v3 para mostrar um vídeo de guia dentro da página.
YOUTUBE_API_KEY=
